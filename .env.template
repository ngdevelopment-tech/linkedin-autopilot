# Optional AI replies; leave blank to use the built-in deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Safe defaults: no message sending or invitation acceptance.
DRY_RUN=true
POLL_SECONDS=12
MAX_THREADS=10
BASELINE_ON_START=true
BASELINE_SCAN_LIMIT=35
ACCEPT_INVITATIONS_ENABLED=true
INVITATION_POLL_SECONDS=120
ALLOWED_SENDER_NAMES=

# Local interactive login defaults. Railway uses true/true with saved profile.
UNATTENDED=false
BROWSER_HEADLESS=false
LOGIN_TIMEOUT_SECONDS=900

BROWSER_PROFILE_DIR=.browser-profile
STATE_DB_PATH=.state/messages.db
